{
  "name": "@pterror/interact-core",
  "version": "0.0.0",
  "private": true,
  "description": "A proof of interact's core contract: widgets as pure init, step and view over plain data, composed by the DOM's event model, drawn by generic renderers",
  "license": "ISC",
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/test-*.js",
    "!src/**/*.test.d.ts",
    "dist",
    "!dist/**/*.test.d.ts",
    "!dist/test-*.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.js"
    }
  }
}
