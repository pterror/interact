{
  "name": "@pterror/interact-list",
  "version": "0.1.0",
  "description": "A list of options people move through, pick from and see, built from small modules wired by hand",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pterror/interact.git",
    "directory": "packages/list"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "dist",
    "!dist/**/*.test.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
