{
  "name": "@pterror/interact-solid",
  "version": "0.1.0",
  "description": "SolidJS and interact's abstractions both ways: signals as Values and Watched, Watched and Tests as accessors, components as what a list draws",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pterror/interact.git",
    "directory": "packages/solid"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/tsconfig.json",
    "dist",
    "!dist/**/*.test.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#test-solid": {
      "solid-2": "./src/solid-2/test-solid.js",
      "default": "./src/solid-1/test-solid.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./2": {
      "types": "./dist/index.d.ts",
      "default": "./src/2.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsgo --noEmit"
  },
  "devDependencies": {
    "@pterror/interact-core": "workspace:*",
    "solid-js": "1.9.17"
  },
  "peerDependencies": {
    "@pterror/interact-core": "workspace:^",
    "@solidjs/web": "^2.0.0-rc.22",
    "solid-js": "^1.8.0 || ^2.0.0-rc.22"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  }
}
