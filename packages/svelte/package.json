{
  "name": "@pterror/interact-svelte",
  "version": "0.0.0",
  "private": true,
  "description": "interact's widgets as Svelte components, generated from each widget's view, props and effects: runes for Svelte 5.26+, the legacy syntax for Svelte 4",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.js",
  "svelte": "src/index.js",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "default": "./src/index.js"
    },
    "./legacy": {
      "svelte": "./src/legacy/index.js",
      "default": "./src/legacy/index.js"
    }
  },
  "devDependencies": {
    "@pterror/interact-core": "workspace:*",
    "svelte": "5.57.3"
  },
  "peerDependencies": {
    "@pterror/interact-core": "workspace:^",
    "svelte": "^4.0.0 || ^5.26.0"
  }
}
