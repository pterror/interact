{
  "name": "keybinds",
  "version": "0.1.0",
  "files": [
    "src",
    "styles",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./styles/*.css"
  ],
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./src/components/*.js"
    },
    "./styles/palette.css": "./styles/palette.css"
  },
  "scripts": {
    "check": "tsgo --noEmit",
    "build:types": "tsgo --declaration --emitDeclarationOnly --outDir dist --rootDir src && find dist -name '*.test.d.ts' -delete && rm -f dist/test-helpers.d.ts"
  }
}
