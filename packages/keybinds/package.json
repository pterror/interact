{
  "name": "@pterror/interact-keybinds",
  "version": "0.1.0",
  "description": "Declarative, contextual keybindings for the web: keys, mouse, gamepad and axes, with a palette, cheatsheet and settings panel",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pterror/interact.git",
    "directory": "packages/keybinds"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/test-*.js",
    "styles",
    "dist",
    "!dist/**/*.test.d.ts",
    "!dist/test-*.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./styles/*.css"
  ],
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.js"
    },
    "./styles/palette.css": "./styles/palette.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsgo --noEmit"
  }
}
