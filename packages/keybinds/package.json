{
  "name": "@pterror/interact-keybinds",
  "version": "0.1.0",
  "description": "Keybindings for the web as small modules wired by hand: keys, mouse, gamepads and axes, rebinding, and an unstyled cheatsheet, radial menu and settings panel",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pterror/interact.git",
    "directory": "packages/keybinds"
  },
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/test-*.js",
    "dist",
    "!dist/**/*.test.d.ts",
    "!dist/test-*.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsgo --noEmit"
  },
  "devDependencies": {
    "@pterror/interact-list": "workspace:*"
  },
  "peerDependencies": {
    "@pterror/interact-list": "workspace:^"
  }
}
