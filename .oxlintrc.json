{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "unicorn",
    "typescript",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "node",
    "jest",
    "vitest",
    "react",
    "react-perf",
    "jsx-a11y",
    "nextjs",
    "vue"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "error"
  },
  // typeCheck stays off: tsgo already type-checks every package in `bun run check`.
  "options": { "typeAware": true, "denyWarnings": true, "reportUnusedDisableDirectives": "error" },
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/docs/.vitepress/**",
    // The fence: keybinds files not yet under the repo's rules (packages/keybinds/TODO.md). test/repo.js reads this
    // list for the rule tests, so it is the one place a file leaves the fence.
    "packages/keybinds/src/axes-ui.js",
    "packages/keybinds/src/axes.js",
    "packages/keybinds/src/axes.test.js",
    "packages/keybinds/src/components/basic-context-menu.js",
    "packages/keybinds/src/components/cheatsheet.js",
    "packages/keybinds/src/components/cheatsheet.test.js",
    "packages/keybinds/src/components/context-menu.js",
    "packages/keybinds/src/components/context-menu.test.js",
    "packages/keybinds/src/components/create.js",
    "packages/keybinds/src/components/create.test.js",
    "packages/keybinds/src/components/palette.js",
    "packages/keybinds/src/components/palette.test.js",
    "packages/keybinds/src/components/radial-menu.js",
    "packages/keybinds/src/components/settings.js",
    "packages/keybinds/src/components/settings.test.js",
    "packages/keybinds/src/gamepad-ui.js",
    "packages/keybinds/src/gamepad.js",
    "packages/keybinds/src/gamepad.test.js",
    "packages/keybinds/src/hub.js",
    "packages/keybinds/src/hub.test.js",
    "packages/keybinds/src/modifiers.js",
    "packages/keybinds/src/search.js",
    "packages/keybinds/src/search.test.js",
    "packages/keybinds/src/store.js",
    "packages/keybinds/src/store.test.js",
    "packages/keybinds/src/test-pads.js",
    "packages/keybinds/styles/palette.css"
  ],
  "rules": {
    // A JSDoc @type on a combined declaration types only its first declarator; typing the others needs an inline
    // comment, which eslint/no-inline-comments forbids.
    "eslint/one-var": "off",
    // Each needs TypeScript-only syntax that is an error in a .js file: `public` (TS8009), `interface` (TS8006),
    // `x!` (TS8013).
    "typescript/explicit-member-accessibility": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/non-nullable-type-assertion-style": "off",
    // Contradict import/no-default-export. Modules export named classes and functions for the app to register.
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    // Contradicts unicorn/prefer-ternary.
    "eslint/no-ternary": "off",
    // Contradicts typescript/prefer-optional-chain.
    "oxc/no-optional-chaining": "off",
    // Contradicts promise/prefer-await-to-then and promise/prefer-await-to-callbacks.
    "oxc/no-async-await": "off",
    // Contradicts eslint/prefer-object-spread.
    "oxc/no-rest-spread-properties": "off",
    // With unicorn/no-null, eslint/no-void and typescript/consistent-return, nothing could express a missing value.
    // undefined is what optional parameters and properties hold.
    "eslint/no-undefined": "off",
    // Contradicts typescript/consistent-return in a function that returns a value or nothing: `return undefined` is
    // what this rule forbids, and a bare `return` is what consistent-return forbids.
    "unicorn/no-useless-undefined": "off",
    // Tests import from bun:test, the runner.
    "vitest/prefer-importing-vitest-globals": "off",
    // Contradicts typescript/promise-function-async, which needs `async` on a function that returns a promise without
    // awaiting it. typescript/require-await checks the rest, knowing which functions return promises.
    "eslint/require-await": "off",
    // A function giving a value it already has as a promise can satisfy only two of three rules:
    // `async () => value` fails typescript/require-await, `() => Promise.resolve(value)` fails
    // typescript/promise-function-async, and `async () => Promise.resolve(value)` fails this one.
    "unicorn/no-useless-promise-resolve-reject": "off",
    // Async work started from a sync event (a read the cache reports on) has to be marked as not awaited:
    // typescript/no-floating-promises accepts only `void` or `.catch()`, promise/prefer-await-to-then forbids `.catch()`,
    // and an async listener fails typescript/no-misused-promises. So `void` is allowed as a statement, nowhere else.
    "eslint/no-void": ["error", { "allowAsStatement": true }],
    "eslint/func-style": ["error", "declaration"],
    // The browser's CSSStyleSheet.replaceSync styles a constructed sheet before the first paint; replace() resolves
    // later. Node's sync methods stay flagged.
    "node/no-sync": ["error", { "ignores": ["replaceSync"] }],
    // Functions that call each other (rendering a template renders its children, which render templates) put one call
    // before the other's declaration whatever the order. Declarations are hoisted; variables and classes stay checked.
    "eslint/no-use-before-define": ["error", { "functions": false }],
    // oxfmt's sortImports orders declarations by source, which this rule's declaration order rejects.
    "eslint/sort-imports": ["error", { "ignoreDeclarationSort": true }],
    // The platform's own types are mutable all the way down, so even Readonly<Event> fails the rule. ReadonlySet,
    // ReadonlyMap and TemplateStringsArray are readonly, yet oxlint 1.90.0 flags them while it passes `readonly T[]`.
    // Behaviors are classes with methods, which the rule otherwise counts as mutable properties; their fields are
    // still checked.
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "treatMethodsAsReadonly": true,
        "allow": [
          {
            "from": "lib",
            "name": [
              "CSSStyleSheet",
              "ChildNode",
              "Comment",
              "CustomElementRegistry",
              "CustomEvent",
              "Document",
              "DocumentFragment",
              "Element",
              "Error",
              "Event",
              "EventTarget",
              "FocusEvent",
              "HTMLElement",
              "KeyboardEvent",
              "KeyboardEventInit",
              "MouseEvent",
              "MouseEventInit",
              "MutationRecord",
              "Node",
              "PointerEvent",
              "Promise",
              "ReadonlyMap",
              "ReadonlySet",
              "RegExp",
              "Request",
              "RegExpExecArray",
              "ShadowRoot",
              "TemplateStringsArray",
              "Text",
              "WheelEvent",
              "Window"
            ]
          },
          // The page a browser test drives is the browser itself.
          { "from": "package", "name": ["Page"], "package": "playwright-core" },
          // What the accessibility checker reports, as it makes it.
          { "from": "package", "name": ["Result", "NodeResult"], "package": "axe-core" }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["test/**", "**/*.test.js"],
      // axe is defined in test pages by axe-core's script (test/axe-global.d.ts).
      "globals": { "Bun": "readonly", "axe": "readonly" }
    },
    {
      // A package's tests use the repo's one browser harness (test/browser.js), which only a parent path reaches; a
      // copy per package would be a second source. Package code is still checked.
      "files": ["packages/*/src/**/*.test.js"],
      "rules": { "import/no-relative-parent-imports": "off" }
    },
    {
      // require-hook is about test files: top-level code there runs outside the runner's hooks. In a module that isn't a
      // test (library source, the preload, the browser harness), top-level code is the module's own initialization,
      // and the rule flags it anyway: a top-level `map.set()` or `let n = 0` in a library module. An override can't
      // scope the plugins themselves (oxlint 1.90.0 neither removes plugins in an override nor applies the base
      // categories to plugins an override adds), and require-hook is the only jest or vitest rule that fires outside
      // test files across the repo.
      "files": ["**/*.js"],
      "excludeFiles": ["**/*.test.js"],
      "rules": { "jest/require-hook": "off", "vitest/require-hook": "off" }
    }
  ]
}
