{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "jsdoc", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "nursery": "error"
  },
  // typeCheck stays off: tsgo already type-checks every package in `bun run check`.
  "options": { "typeAware": true, "denyWarnings": true, "reportUnusedDisableDirectives": "error" },
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/docs/.vitepress/**"],
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/no-empty": "error",
    "eslint/no-proto": "error",
    "eslint/no-var": "error",
    // `void` marks a promise started from a sync event as not awaited, which typescript/no-floating-promises accepts.
    "eslint/no-void": ["error", { "allowAsStatement": true }],
    "eslint/unicode-bom": "error",
    "import/no-cycle": "error",
    "import/no-amd": "error",
    "import/no-commonjs": "error",
    "import/unambiguous": "error",
    "oxc/bad-bitwise-operator": "error",
    "promise/catch-or-return": "error",
    "jsdoc/empty-tags": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-namespace": "error",
    // The browser's CSSStyleSheet.replaceSync styles a constructed sheet before the first paint; replace() resolves
    // later. Node's sync methods stay flagged.
    "node/no-sync": ["error", { "ignores": ["replaceSync"] }],
    // Behaviors are readonly to their views (docs/design.md). The platform's own types are mutable all the way down,
    // so even Readonly<Event> fails the rule. ReadonlySet, ReadonlyMap and TemplateStringsArray are readonly, yet
    // oxlint 1.90.0 flags them while it passes `readonly T[]`. Behaviors are classes with methods, which the rule
    // otherwise counts as mutable properties; their fields are still checked.
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "treatMethodsAsReadonly": true,
        "allow": [
          {
            "from": "lib",
            "name": [
              "CSSStyleSheet",
              "ChildNode",
              "Comment",
              "CustomElementRegistry",
              "CustomEvent",
              "Document",
              "DocumentFragment",
              "Element",
              "Error",
              "Event",
              "EventTarget",
              "FocusEvent",
              "HTMLElement",
              "HTMLDivElement",
              "HTMLInputElement",
              "HTMLLIElement",
              "HTMLUListElement",
              "KeyboardEvent",
              "KeyboardEventInit",
              "MouseEvent",
              "MouseEventInit",
              "MutationRecord",
              "Node",
              "PointerEvent",
              "Promise",
              "ReadonlyMap",
              "ReadonlySet",
              "RegExp",
              "Request",
              "RegExpExecArray",
              "SVGElement",
              "SVGGElement",
              "SVGSVGElement",
              "ShadowRoot",
              "TemplateStringsArray",
              "Text",
              "WheelEvent",
              "Window"
            ]
          },
          // The page a browser test drives is the browser itself.
          { "from": "package", "name": ["Page"], "package": "playwright-core" },
          // What the accessibility checker reports, as it makes it.
          { "from": "package", "name": ["Result", "NodeResult"], "package": "axe-core" },
          // Syntax trees, editor states and change sets are immutable values, and a view is the editor itself; their
          // classes still declare fields the rule counts as mutable.
          {
            "from": "package",
            "name": ["Parser", "SyntaxNode", "SyntaxNodeRef", "Tree", "TreeFragment"],
            "package": "@lezer/common"
          },
          {
            "from": "package",
            "name": [
              "ChangeDesc",
              "ChangeSet",
              "EditorState",
              "Extension",
              "Range",
              "RangeSet",
              "StateField",
              "Text",
              "Transaction"
            ],
            "package": "@codemirror/state"
          },
          {
            "from": "package",
            "name": ["BlockWrapper", "Decoration", "EditorView", "ViewPlugin", "ViewUpdate", "WidgetType"],
            "package": "@codemirror/view"
          },
          { "from": "package", "name": ["Completion", "CompletionContext"], "package": "@codemirror/autocomplete" }
        ]
      }
    ],

    // Shape, not defects: these split code by size or count, or pick one of two equivalent spellings.
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-statements": "off",
    "eslint/max-params": "off",
    "eslint/max-depth": "off",
    "eslint/max-nested-callbacks": "off",
    "eslint/max-classes-per-file": "off",
    "import/max-dependencies": "off",
    "unicorn/max-nested-calls": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/id-length": "off",
    "eslint/sort-keys": "off",
    "eslint/no-inline-comments": "off",
    "eslint/capitalized-comments": "off",
    "eslint/init-declarations": "off",
    "eslint/prefer-destructuring": "off",
    "eslint/no-continue": "off",
    "eslint/no-ternary": "off",
    "eslint/no-nested-ternary": "off",
    "unicorn/no-nested-ternary": "off",
    "eslint/one-var": "off",
    "eslint/func-style": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "eslint/no-lonely-if": "off",
    "unicorn/no-lonely-if": "off",
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    "promise/prefer-await-to-then": "off",
    "promise/prefer-await-to-callbacks": "off",
    // oxfmt's sortImports orders imports.
    "eslint/sort-imports": "off",
    // Needs TypeScript-only syntax, an error in a .js file: `interface` (TS8006).
    "typescript/consistent-type-definitions": "off",
    // tsgo finds undefined names, knowing the globals each tsconfig declares.
    "eslint/no-undef": "off",
    // Flags an async function that doesn't await, where `async` is what makes a value that may be a promise always
    // one (`async count()` over a source counting at once or later). typescript/require-await checks the rest,
    // knowing which functions return promises.
    "eslint/require-await": "off",
    // Contradicts typescript/consistent-return in a function that returns a value or nothing: `return undefined` is
    // what this rule forbids, and a bare `return` is what consistent-return forbids.
    "unicorn/no-useless-undefined": "off",
    // Fires on a map over an array the function didn't receive (Object.entries(), a copy, a call's result), whose
    // objects are still the caller's. Its fix is Object.assign onto the element, which mutates the caller's readonly
    // objects (TypeScript can't see it: Object.assign's target is generic).
    "oxc/no-map-spread": "off"
  }
}
